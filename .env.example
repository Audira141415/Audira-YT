# Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=youtube_monitor
DATABASE_URL=postgresql://postgres:postgres@db:5432/youtube_monitor

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security
JWT_SECRET=generate_a_very_secure_secret_key_here
ENCRYPTION_KEY=generate_a_32_byte_url_safe_base64_encoded_key_here

# Google / YouTube API
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# AI Provider
AI_PROVIDER=gemini # or openai, claude
AI_API_KEY=your_ai_api_key_here
