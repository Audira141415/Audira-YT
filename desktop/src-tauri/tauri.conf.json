{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audira YT Monitor",
  "version": "1.0.0",
  "identifier": "com.audira.ytmonitor",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3005",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "Audira YT Monitor - Desktop Application",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
